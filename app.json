{
  "expo": {
    "name": "PulseNet",
    "slug": "pulsenet",
    "scheme": "pulsenet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulsenet.pulsenet",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PulseNet adds your location to emergency alerts and finds help near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PulseNet keeps sharing your location during an emergency or a walk.",
        "NSMicrophoneUsageDescription": "Used only for the distress-word listener you arm yourself.",
        "NSSpeechRecognitionUsageDescription": "Used only for the distress-word listener you arm yourself.",
        "NSBluetoothAlwaysUsageDescription": "Used to read heart rate from your Bluetooth wearable."
      }
    },
    "android": {
      "package": "com.pulsenet.pulsenet",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SEND_SMS",
        "android.permission.CALL_PHONE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/pulsenet_logo.png",
          "backgroundColor": "#0B0B10",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PulseNet keeps sharing your location during an emergency or a walk.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E11D48"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used only for the distress-word listener you arm yourself.",
          "speechRecognitionPermission": "Used only for the distress-word listener you arm yourself.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Used to read heart rate from your Bluetooth wearable."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PulseNet attaches photos you choose to an incident report.",
          "cameraPermission": "PulseNet takes a photo you choose to attach to an incident report."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f6cb5b18-b379-49b1-94e9-b88e6fb6f27b"
      }
    },
    "owner": "lungstardaking"
  }
}